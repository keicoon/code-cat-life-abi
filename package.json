{
  "name": "code-cat",
  "displayName": "Code Cat",
  "description": "A cute white cat that lives in your editor, treating code as a platformer terrain",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCat.toggle",
        "title": "Code Cat: Toggle"
      }
    ],
    "configuration": {
      "title": "Code Cat",
      "properties": {
        "codeCat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Code Cat"
        },
        "codeCat.idleTimeout": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Seconds of inactivity before the cat appears"
        },
        "codeCat.fishInterval": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 30,
          "description": "Seconds between fish spawns"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
