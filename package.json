{
  "name": "code-cat-life-abi",
  "displayName": "Code Cat Life Abi",
  "description": "A cute white cat that lives in your editor, treating code as a platformer terrain",
  "version": "0.2.0",
  "publisher": "keicoon15",
  "icon": "icon.png",
  "keywords": [
    "cat",
    "pet",
    "editor",
    "animation",
    "fun",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCatLifeAbi.toggle",
        "title": "Code Cat Life Abi: Toggle"
      },
      {
        "command": "codeCatLifeAbi.showLogs",
        "title": "Code Cat Life Abi: Show Logs"
      }
    ],
    "icons": {
      "code-cat-life-abi-sleep": {
        "description": "Sleeping cat icon for the Code Cat Life Abi status bar",
        "default": {
          "fontPath": "./media/statusbar/code-cat-status.woff",
          "fontCharacter": "\\F101"
        }
      }
    },
    "configuration": {
      "title": "Code Cat Life Abi",
      "properties": {
        "codeCatLifeAbi.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Code Cat Life Abi"
        },
        "codeCatLifeAbi.catColor": {
          "type": "string",
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Cat color in hex (e.g. #ffffff for white, #ff9900 for orange). Paw prints will match."
        },
        "codeCatLifeAbi.idleTimeout": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "description": "Seconds of inactivity before Code Cat Life Abi appears in the editor"
        },
        "codeCatLifeAbi.sleepTime": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 30,
          "description": "Seconds the cat sleeps after finishing one fish session before the next session begins"
        },
        "codeCatLifeAbi.fishSessionCount": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Number of consecutive fish the cat chases before it goes to sleep"
        },
        "codeCatLifeAbi.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Animation speed multiplier applied to running, jumping, falling, and chase timing (0.5 = slow, 1.0 = normal, 2.0 = fast)"
        },
        "codeCatLifeAbi.showFootprints": {
          "type": "boolean",
          "default": true,
          "description": "Show paw print trail behind the cat while running"
        },
        "codeCatLifeAbi.debugMovementLogs": {
          "type": "boolean",
          "default": false,
          "description": "Log movement, despawn/reset reasons, and vertical transition diagnostics to the Code Cat Life Abi output channel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "tsc -p ./ && node --test out/*.test.js",
    "test:integration": "tsc -p ./ && node out/integration/run-vscode-tests.js",
    "package:vsix": "npm run compile && npx @vscode/vsce package",
    "publish:vsix": "npm run compile && npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^10.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.73.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/keicoon/code-cat-life-abi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keicoon/code-cat-life-abi.git"
  },
  "homepage": "https://github.com/keicoon/code-cat-life-abi#readme"
}
