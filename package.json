{
  "name": "code-cat",
  "displayName": "Code Cat",
  "description": "A cute white cat that lives in your editor, treating code as a platformer terrain",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCat.toggle",
        "title": "Code Cat: Toggle"
      }
    ],
    "configuration": {
      "title": "Code Cat",
      "properties": {
        "codeCat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Code Cat"
        },
        "codeCat.catColor": {
          "type": "string",
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Cat color in hex (e.g. #ffffff for white, #ff9900 for orange). Paw prints will match."
        },
        "codeCat.idleTimeout": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Seconds of inactivity before the cat appears"
        },
        "codeCat.fishInterval": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 30,
          "description": "Seconds between fish spawns"
        },
        "codeCat.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Animation speed multiplier (0.5 = slow, 1.0 = normal, 2.0 = fast)"
        },
        "codeCat.showFootprints": {
          "type": "boolean",
          "default": true,
          "description": "Show paw print trail behind the cat while running"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "tsc -p ./ && node out/cat-physics.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
